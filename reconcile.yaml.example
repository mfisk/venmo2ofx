# Example reconcile.yaml for reconcile.py
#
# Copy this to reconcile.yaml and fill in your own accounts and patterns.
# See RULES.md for the full rule format documentation.
#
# Rules use if:/then: structure. Filters (nouns) go under if:, side-effects
# (verbs) go under then:. All top-level terms in if: are ANDed; for OR,
# use separate rules. First match wins.

source_accounts:
  # Map input accounts to account paths in your bookkeeping software.
  # Use placeholder values — never commit real account numbers.
  # Each entry matches on mask (last4); institution and account_type
  # disambiguate when two accounts share a mask.
  - account: Assets:Checking
    mask: 'AAAA'
    institution: Example Bank
    account_type: checking
  - account: Assets:Savings
    mask: 'BBBB'
    institution: Example Bank
    account_type: savings
  - account: Liabilities:Credit Card
    mask: 'CCCC'
    institution: Example Card
    account_type: credit

rules:
  # Group by source; children inherit it.
  - source: Assets:Checking
    rules:
      - if:
          desc:
            - CORNER MARKET
            - FRESH FIELDS
        then: Expenses:Groceries

      # Transfers are just rules between two source accounts.
      # Pairing is automatic when both accounts are in source_accounts:.
      - if:
          desc:
            - ONLINE PAYMENT
            - PAYMENT THANK YOU
        then: Liabilities:Credit Card

      # Bare string shorthand for if: desc
      - if: BLUE BOTTLE
        then: Expenses:Dining

      # Compound: desc + mcc must both match (AND)
      - if:
          desc: BLUE BOTTLE
          pfc: [FOOD_AND_DRINK_COFFEE]
        then: Expenses:Dining

      # Check numbers are exact per-account identifiers. Two formats:
      # a plain list, or a dict mapping payee names to lists of numbers
      # (which also sets the payee from check images).
      - if:
          checks:
            CITY GARAGE LLC: ['1042', '1043']
        then: Expenses:Parking
      - if:
          checks: ['2041', '2042']
        then: Expenses:Office

      # Amount conditions use signed amounts: negative = debit (money out),
      # positive = credit (money in). Value can be exact (amount: 100)
      # or a comparison string (amount: ">0", amount: "<0").
      #
      # FALLBACK: Mark catch-all rules with `fallback: true`. They are only
      # tried after all regular rules, ensuring a specific rule always wins.
      # Fallback-matched transactions are flagged for review.
      - if:
          amount: ">0"
        then: Income:Interest
        fallback: true

  - source: Assets:Savings
    rules:
      - if:
          amount: ">0"
        then: Income:Interest
        fallback: true

  # Offsets: conditional double-entry transactions in then:
  - source: Assets:Checking
    rules:
      - if: PAYROLL
        then:
          account: Expenses:Payroll
          offsets:
            - if:
                memo_regex: 'Bonus\s+\$([\d,]+\.?\d*)'
              debit: Assets:Bonus
              credit: Expenses:Payroll:Bonus
              describe_as: 'Bonus for {payee}'

  # FITID: exact transaction ID (cannot combine with other filters)
  - source: Assets:Checking
    rules:
      - if:
          fitid: 'abc123def456'
        then: Expenses:OneOff
